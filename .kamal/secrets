# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# このプロジェクトでは秘密情報を Rails credentials（config/credentials.yml.enc）に集約する。
# 編集は `bin/rails credentials:edit`。手元に必要な鍵は config/master.key だけ。

RAILS_MASTER_KEY=$(cat config/master.key)

# PostgreSQL のパスワード。アプリ（database.yml）と accessory（POSTGRES_PASSWORD）で同じ値を参照する。
POSTGRES_PASSWORD=$(bin/rails credentials:fetch db.password)
JOMO_KARUTA_TYPING_RAILS_APP_DATABASE_PASSWORD=$(bin/rails credentials:fetch db.password)

# 本番用 OAuth クレデンシャル（dev/test は .env + dotenv-rails、本番はここから注入）
GOOGLE_CLIENT_ID=$(bin/rails credentials:fetch google.client_id)
GOOGLE_CLIENT_SECRET=$(bin/rails credentials:fetch google.client_secret)
GITHUB_CLIENT_ID=$(bin/rails credentials:fetch github.client_id)
GITHUB_CLIENT_SECRET=$(bin/rails credentials:fetch github.client_secret)

# 運営のメール許可リスト（カンマ区切り）。アプリは ENV["ADMIN_EMAILS"] だけを読む。
# credentials に admin.emails を入れてからこの行をデプロイすること（未投入だと credentials:fetch でデプロイが落ちる）。
ADMIN_EMAILS=$(bin/rails credentials:fetch admin.emails)
